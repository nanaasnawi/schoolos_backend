# ============================================================
# School OS Backend — Environment Variables Template
# JANGAN SIMPAN KREDENSIAL ASLI DI DALAM REPOSITORY INI!
# ============================================================

# Database Connection (Default: PostgreSQL Local Docker Port 5433 - Tidak bentrok dengan Dapodik port 5432)
DATABASE_URL=postgresql://school_admin:secretpassword@localhost:5433/school_os
PORT=8000

# Security: JWT Secret (WAJIB diisi dengan random string minimal 32 karakter)
# Generate dengan: openssl rand -base64 32
JWT_SECRET=generate_strong_secret_key_minimum_32_characters_here

# Firebase Cloud Messaging (FCM HTTP v1)
FCM_PROJECT_ID=akselerasi-edu
GOOGLE_APPLICATION_CREDENTIALS=api-server/firebase-service-account.json

# Environment mode (development / production)
APP_ENV=development
