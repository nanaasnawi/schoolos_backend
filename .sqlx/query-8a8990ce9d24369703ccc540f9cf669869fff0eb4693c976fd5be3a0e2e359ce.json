{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email, u.full_name, u.is_active, u.created_at,\n               COALESCE(r.name, 'No Role') as role_name\n        FROM users u\n        LEFT JOIN user_roles ur ON u.id = ur.user_id\n        LEFT JOIN roles r ON ur.role_id = r.id\n        WHERE u.tenant_id = $1\n        ORDER BY u.created_at DESC\n        ",
