{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            s.id as student_id,\n            s.full_name as student_name,\n            s.nisn as student_nisn,\n            g.id as \"guardian_id?\",\n            g.full_name as \"guardian_name?\",\n            COALESCE(g.phone_number, s.no_hp, '') as \"phone?\"\n        FROM students s\n        LEFT JOIN guardians g ON g.id = s.guardian_id\n        WHERE s.tenant_id = $1\n        ORDER BY s.full_name ASC\n        ",
