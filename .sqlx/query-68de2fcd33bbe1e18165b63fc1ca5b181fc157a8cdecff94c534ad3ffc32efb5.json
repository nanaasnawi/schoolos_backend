{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            s.id, s.full_name, s.nisn, s.gender, s.status, s.no_hp, s.email,\n            c.id as class_id, c.name as class_name\n        FROM students s\n        JOIN enrollments en ON en.student_id = s.id\n        JOIN classes c ON c.id = en.class_id\n        WHERE c.id = $1\n        ORDER BY s.full_name ASC\n        ",
