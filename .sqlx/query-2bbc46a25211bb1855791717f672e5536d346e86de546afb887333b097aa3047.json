{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, t.name as \"tenant_name?\", a.action as event_type, \n               COALESCE(a.resource || ' (' || a.decision || ')', a.decision) as \"details!\", \n               a.timestamp as created_at\n        FROM audit_logs a\n        LEFT JOIN tenants t ON t.id = a.tenant_id\n        ORDER BY a.timestamp DESC\n        LIMIT 50\n        ",
