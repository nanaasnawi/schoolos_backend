  "query": "\n        SELECT u.id, u.email, u.full_name, r.name as \"role_name?\"\n        FROM users u\n        LEFT JOIN user_roles ur ON ur.user_id = u.id\n        LEFT JOIN roles r ON r.id = ur.role_id\n        WHERE u.tenant_id = $1 AND u.is_active = true\n        LIMIT 1\n        ",
